---
// 根路径：客户端检测系统语言并重定向
// 优先级：localStorage 手动选择 > navigator.language > 默认 en
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>THE BERRY — Berry Wahlberg / 花雨琦</title>
    <script is:inline>
      (function () {
        var SUPPORTED = ['en', 'zh'];
        var DEFAULT = 'en';
        var lang = DEFAULT;
        try {
          var saved = localStorage.getItem('berry-lang');
          if (saved && SUPPORTED.indexOf(saved) !== -1) {
            lang = saved;
          } else {
            // 英语优先：遍历完整语言偏好列表，含 en 即选英文；仅纯中文环境选中文
            var list = (navigator.languages && navigator.languages.length)
              ? navigator.languages
              : [navigator.language || DEFAULT];
            var hasZh = false;
            for (var i = 0; i < list.length; i++) {
              var code = String(list[i]).toLowerCase().split('-')[0];
              if (code === 'en') { lang = 'en'; break; }
              if (code === 'zh') { hasZh = true; }
            }
            if (lang === DEFAULT && hasZh) { lang = 'zh'; }
          }
        } catch (e) {
          lang = DEFAULT;
        }
        location.replace('{base}/' + lang + '/');
      })();
    </script>
  </head>
  <body>
    <p style="font-family:system-ui;padding:24px;color:#666">
      Redirecting to your language… / 正在为你切换语言…
    </p>
  </body>
</html>
