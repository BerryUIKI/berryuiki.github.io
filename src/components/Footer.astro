---
import type { Locale } from '../i18n/translations';
import { getTranslation } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const anchors = [
  { key: 'about', label: t.footer.navLinks[0] },
  { key: 'skills', label: t.footer.navLinks[1] },
  { key: 'work', label: t.footer.navLinks[2] },
  { key: 'contact', label: t.footer.navLinks[3] },
];
const socialUrls = [
  'https://github.com/BerryUIKI',
  'https://www.linkedin.com/',
  '#',
];
const contactHrefs = [`mailto:${t.contact.email}`, '#'];
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="logo">THE BERRY</div>
        <p>{t.footer.tagline}</p>
      </div>
      <div class="footer__cols">
        <div class="footer__col">
          <h4>{t.footer.navTitle}</h4>
          {anchors.map((a) => (
            <a href={`${base}/${locale}/#${a.key}`}>{a.label}</a>
          ))}
        </div>
        <div class="footer__col">
          <h4>{t.footer.socialTitle}</h4>
          {t.footer.socialLinks.map((s, i) => (
            <a href={socialUrls[i]}>{s}</a>
          ))}
        </div>
        <div class="footer__col">
          <h4>{t.footer.contactTitle}</h4>
          {t.footer.contactLinks.map((c, i) => (
            <a href={contactHrefs[i]}>{c}</a>
          ))}
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>{t.footer.copyright}</span>
      <span>EN | 中文</span>
    </div>
  </div>
</footer>
