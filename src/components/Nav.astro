---
import { getTranslation } from '../i18n/translations';
import type { Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const anchors = [
  { key: 'about', label: t.nav.about },
  { key: 'skills', label: t.nav.skills },
  { key: 'experience', label: t.nav.experience },
  { key: 'work', label: t.nav.work },
  { key: 'contact', label: t.nav.contact },
];
---

<nav class="global-nav">
  <a class="global-nav__logo" href={`${base}/${locale}/`}>THE BERRY</a>

  <ul class="global-nav__links">
    {anchors.map((a) => (
      <li><a href={`${base}/${locale}/#${a.key}`}>{a.label}</a></li>
    ))}
  </ul>

  <div class="global-nav__actions">
    <div class="lang-switch" role="group" aria-label={t.langSwitch.label}>
      <a href={`${base}/en/`} aria-current={locale === 'en' ? 'true' : undefined} lang="en">EN</a>
      <a href={`${base}/zh/`} aria-current={locale === 'zh' ? 'true' : undefined} lang="zh">中文</a>
    </div>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle theme">
      <svg id="theme-icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="5" />
        <path d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" />
      </svg>
      <svg id="theme-icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
      </svg>
    </button>
  </div>
</nav>

<script>
  // 语言切换持久化：点击语言链接时记住选择，下次访问直接用
  document.querySelectorAll('.lang-switch a').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('berry-lang', link.getAttribute('lang') || '');
      } catch (e) {}
    });
  });

  // 暗色/亮色切换：localStorage 持久化
  const toggle = document.getElementById('theme-toggle') as HTMLButtonElement;
  const sun = document.getElementById('theme-icon-sun') as SVGElement;
  const moon = document.getElementById('theme-icon-moon') as SVGElement;
  const root = document.documentElement;

  function syncIcon() {
    const dark = root.getAttribute('data-theme') === 'dark';
    sun.style.display = dark ? 'none' : '';
    moon.style.display = dark ? '' : 'none';
  }
  syncIcon();

  toggle.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('berry-theme', next);
    } catch (e) {}
    syncIcon();
  });
</script>
