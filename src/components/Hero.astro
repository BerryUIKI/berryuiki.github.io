---
import heroImg from '../assets/hero.jpg';
import type { Locale } from '../i18n/translations';
import { getTranslation } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="top">
  <picture>
    <source media="(max-width: 640px)" srcset={new URL('../assets/hero-mobile.jpg', import.meta.url).href} />
    <img class="hero__img" src={heroImg.src} alt="" width={heroImg.width} height={heroImg.height} />
  </picture>
  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__eyebrow">{t.hero.eyebrow}</p>
    <p class="hero__badge">{t.hero.badge}</p>
    <h1 class="hero__title">{t.hero.title}</h1>
    <p class="hero__subtitle">{t.hero.subtitle}</p>
    <div class="hero__ctas">
      <a class="btn btn-primary" href={`${base}/${locale}/#work`}>{t.hero.ctaPrimary}</a>
      <a class="btn btn-ghost-on-dark" href={`${base}/${locale}/#contact`}>{t.hero.ctaSecondary}</a>
    </div>
  </div>

  <a class="hero__scroll-hint" href="#about" aria-label="Scroll to content">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 9l6 6 6-6"/>
    </svg>
  </a>
</section>

<script>
  // Apple 产品页式滚动动效：滚动时照片缩小 + 下移 + 渐隐（加强版）
  const hero = document.querySelector('.hero') as HTMLElement;
  const img = hero?.querySelector('.hero__img') as HTMLImageElement;
  const scrim = hero?.querySelector('.hero__scrim') as HTMLElement;

  function updateHero() {
    if (!hero || !img) return;
    const y = window.scrollY;
    const max = Math.max(hero.offsetHeight, 1);
    const p = Math.min(y / max, 1);
    const scale = 1 - 0.45 * p;
    const translateY = 120 * p;
    img.style.transform = `scale(${scale}) translateY(${translateY}px)`;
    img.style.opacity = String(1 - 0.6 * p);
    // 下滑时底部两角渐变圆角（全屏直角 → 卡片圆角）
    const br = Math.round(28 * p);
    img.style.borderRadius = `0 0 ${br}px ${br}px`;
    // scrim 随滚动淡出，露出纯色主题背景（亮色=白 / 暗色=黑）
    if (scrim) scrim.style.opacity = String(1 - 0.92 * p);
  }

  let ticking = false;
  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(() => {
        updateHero();
        ticking = false;
      });
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  updateHero();
</script>
